    "rows": [
      {
        "prompt": "Каждый человек",
        "phrase": "заслуживает счастья."
      },
      {
        "prompt": "Чтобы стать успешным, важно",
        "phrase": "определить свои цели и приоритеты."
      },
      {
        "prompt": "Не все люди связывают счастье",
        "phrase": "с материальным достатком."
      },
      {
        "prompt": "Русские не любят признаваться",
        "phrase": "в том, что счастливы или успешны."
      },
      {
        "prompt": "Подростки часто считают известность и",
        "phrase": "богатство синонимом успеха."
      },
      {
        "prompt": "Люди старшего поколения больше всего",
        "phrase": "ценят здоровье и мир в семье."
      },
      {
        "prompt": "Достигнуть успеха невозможно",
        "phrase": "без понимания самого себя."
      },
      {
        "prompt": "Можно сделать отличную карьеру и",
        "phrase": "остаться несчастливым."
      },
      {
        "prompt": "Преуспевающий человек, как правило,",
        "phrase": "занимает высокую должность."
      },
      {
        "prompt": "У каждого человека свой список",
        "phrase": "жизненных ценностей."
      },
      {
        "prompt": "Все счастливые семьи",
        "phrase": "похожи друг на друга. (Л. Толстой)"
      },
      {
        "prompt": "Удача — это быть в нужное время",
        "phrase": "в нужном месте."
      }
    ]
  }
