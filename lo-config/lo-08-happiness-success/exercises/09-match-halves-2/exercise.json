{
  "type": "phrase-reorder",
  "title": "Part 2",
  "content": {
    "rows": [
      {
        "prompt": "К успеху можно прийти",
        "phrase": "разными путями."
      },
      {
        "prompt": "Только тот, кто живёт для других, может",
        "phrase": "быть по-настоящему счастлив."
      },
      {
        "prompt": "Материальная независимость и богатство",
        "phrase": "не всегда делают человека счастливым."
      },
      {
        "prompt": "Лучше сойти с ума от счастья,",
        "phrase": "чем от неудач. (Ф. Ницше)"
      },
      {
        "prompt": "Правильно поставленная цель поможет",
        "phrase": "вам добиться успеха и избежать неудачи."
      },
      {
        "prompt": "Для многих людей работа по душе",
        "phrase": "важнее, чем материальное благополучие."
      },
      {
        "prompt": "Добиться успеха может только тот,",
        "phrase": "кто чётко понимает, что ему нужно."
      },
      {
        "prompt": "Успешная карьера может",
        "phrase": "стоить семейного счастья."
      },
      {
        "prompt": "Не стоит сравнивать себя с другими,",
        "phrase": "чтобы чувствовать себя счастливым."
      },
      {
        "prompt": "Занятие любимым делом",
        "phrase": "приносит удовлетворение."
      },
      {
        "prompt": "Не родись красивой,",
        "phrase": "а родись счастливой."
      },
      {
        "prompt": "Счастливыми не рождаются,",
        "phrase": "ими становятся."
      }
    ]
  }
}
