    "rows": [
      {
        "prompt": "В общежитии и в коммуналке важно,",
        "phrase": "чтобы тебе повезло с соседями."
      },
      {
        "prompt": "Под одной крышей в коммуналке",
        "phrase": "оказываются самые разные люди."
      },
      {
        "prompt": "Уезжая за границу, дипломат",
        "phrase": "решил сдать свою квартиру."
      },
      {
        "prompt": "В общежитии запрещено",
        "phrase": "заводить домашних животных."
      },
      {
        "prompt": "В общежитии необязательно есть",
        "phrase": "ванная в каждой комнате."
      },
      {
        "prompt": "Отказаться от вечеринок трудно,",
        "phrase": "если вы живёте в общежитии."
      },
      {
        "prompt": "В жизни за городом",
        "phrase": "есть свои преимущества и недостатки."
      },
      {
        "prompt": "Иметь собственный дом –",
        "phrase": "мечта многих людей."
      },
      {
        "prompt": "Если вы хотите снять или сдать квартиру,",
        "phrase": "обратитесь в агентство недвижимости."
      },
      {
        "prompt": "Некоторые студенты снимают квартиру,",
        "phrase": "так как в общежитии не хватает мест."
      }
    ]
  }
