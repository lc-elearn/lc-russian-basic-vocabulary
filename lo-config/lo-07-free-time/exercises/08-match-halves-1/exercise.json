  "title": "Part 1",
  "content": {
    "rows": [
      {
        "prompt": "Я мечтаю побывать в",
        "phrase": "самых дальних уголках мира."
      },
      {
        "prompt": "Массовая культура влияет",
        "phrase": "на наши интересы и увлечения."
      },
      {
        "prompt": "После рабочего дня хочется",
        "phrase": "отдохнуть в приятной обстановке."
      },
      {
        "prompt": "Активный отдых необязательно",
        "phrase": "подходит всем людям."
      },
      {
        "prompt": "Оформление визы требует",
        "phrase": "много времени и терпения."
      },
      {
        "prompt": "Существует множество способов",
        "phrase": "провести каникулы с пользой."
      },
      {
        "prompt": "Мы заплатили бешеные деньги",
        "phrase": "за проживание в гостинице."
      },
      {
        "prompt": "Сейчас стало модно разбираться",
        "phrase": "в кулинарии и в винах."
      },
      {
        "prompt": "Совмещать работу и отдых проще,",
        "phrase": "чем может показаться."
      },
      {
        "prompt": "Современный театр во многом",
        "phrase": "отличается от традиционного."
      },
      {
        "prompt": "Путешествовать автостопом",
        "phrase": "рискованно и небезопасно."
      }
    ]
  }
