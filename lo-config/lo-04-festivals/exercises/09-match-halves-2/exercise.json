    "rows": [
      {
        "prompt": "Семейные традиции – это",
        "phrase": "способ создать дружную семью."
      },
      {
        "prompt": "Многие русские праздники – это смесь",
        "phrase": "православия и язычества."
      },
      {
        "prompt": "Если человеку не хватает радости, он",
        "phrase": "пытается компенсировать это алкоголем."
      },
      {
        "prompt": "Многие традиции и обычаи",
        "phrase": "со временем исчезают."
      },
      {
        "prompt": "Праздники объединяют",
        "phrase": "людей разных поколений."
      },
      {
        "prompt": "Традиции – это возможность создать",
        "phrase": "атмосферу теплоты, доверия в семье."
      },
      {
        "prompt": "На день рождения принято",
        "phrase": "дарить подарки."
      },
      {
        "prompt": "Умение делать хорошие подарки –",
        "phrase": "вопрос не только денег, но и вкуса."
      },
      {
        "prompt": "Праздники дают нам",
        "phrase": "положительные эмоции."
      },
      {
        "prompt": "Без праздников, юбилеев и вечеринок",
        "phrase": "жизнь была бы скучна и неинтересна."
      },
      {
        "prompt": "Некоторые люди плохо относятся к",
        "phrase": "коммерческим праздникам."
      }
    ]
  }
