  "content": {
    "rows": [
      {
        "prompt": "Студентам сложно вести",
        "phrase": "здоровый образ жизни."
      },
      {
        "prompt": "Многие студенты в Кембридже",
        "phrase": "жалуются на недосып."
      },
      {
        "prompt": "Многим людям снять стресс",
        "phrase": "помогают домашние животные."
      },
      {
        "prompt": "Причины утомления",
        "phrase": "во вредных привычках."
      },
      {
        "prompt": "Из-за стресса и усталости",
        "phrase": "иммунная система ослабевает."
      },
      {
        "prompt": "Очень полезно начинать день",
        "phrase": "с холодного душа."
      },
      {
        "prompt": "Крепкий чай и кофе",
        "phrase": "обезвоживают организм."
      },
      {
        "prompt": "Диетологи советуют",
        "phrase": "есть понемногу."
      },
      {
        "prompt": "Активность организма снижается",
        "phrase": "без витаминов и минералов."
      },
      {
        "prompt": "Бороться со стрессом помогают",
        "phrase": "регулярные занятия спортом."
      },
      {
        "prompt": "Зимой и весной обязательно есть",
        "phrase": "много фруктов и овощей."
      }
    ]
  }
