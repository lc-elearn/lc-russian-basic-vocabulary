  "content": {
    "rows": [
      {
        "prompt": "Считается, что между внешностью и",
        "phrase": "характером есть прямая связь."
      },
      {
        "prompt": "Талантливые люди",
        "phrase": "талантливы во всём."
      },
      {
        "prompt": "Врач должен быть",
        "phrase": "сострадательным и терпеливым."
      },
      {
        "prompt": "Людям очень высокого роста",
        "phrase": "трудно покупать одежду."
      },
      {
        "prompt": "У неискренних и нетактичных людей",
        "phrase": "мало друзей."
      },
      {
        "prompt": "Оптимист никогда",
        "phrase": "не падает духом."
      },
      {
        "prompt": "Самоуверенные и самовлюблённые люди",
        "phrase": "склонны к ссорам и конфликтам."
      },
      {
        "prompt": "В сложной ситуации помогают",
        "phrase": "остроумие и чувство юмора."
      },
      {
        "prompt": "Невежливо опаздывать и",
        "phrase": "заставлять других ждать тебя."
      },
      {
        "prompt": "Супруги со временем становятся",
        "phrase": "похожими друг на друга."
      },
      {
        "prompt": "Скажи мне, кто твой друг,",
        "phrase": "и я скажу тебе, кто ты."
      }
    ]
  }
