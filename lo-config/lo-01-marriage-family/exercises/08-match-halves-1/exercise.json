  "content": {
    "rows": [
      {
        "prompt": "Любовь и уважение –",
        "phrase": "самое главное в семейных отношениях."
      },
      {
        "prompt": "Сегодня многие молодые люди скептически",
        "phrase": "относятся к браку."
      },
      {
        "prompt": "Официально не зарегистрированный брак",
        "phrase": "скоро станет нормой."
      },
      {
        "prompt": "Многие считают, что общество",
        "phrase": "стало безнравственным."
      },
      {
        "prompt": "Содержать семью",
        "phrase": "сегодня не просто."
      },
      {
        "prompt": "Семейным людям часто приходится",
        "phrase": "ограничивать свои желания."
      },
      {
        "prompt": "Женатые мужчины говорят, что им",
        "phrase": "не хватает личной свободы."
      },
      {
        "prompt": "Скандалы и конфликты в семье",
        "phrase": "разрушают семейные отношения."
      },
      {
        "prompt": "Трудно поверить, что любовь и семья могут",
        "phrase": "помешать профессиональному росту."
      },
      {
        "prompt": "Замужние женщины недовольны",
        "phrase": "тем, что быт требует много времени и сил."
      },
      {
        "prompt": "Моя сестра мечтает",
        "phrase": "выйти замуж за миллионера."
      }
    ]
  }
}
